# ── FlyHND 3.0 — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
#
# ── Live search provider (pick ONE) ────────────────────────────────────
#
# Option A: SerpApi  (recommended — global location search + Google Flights)
#   Free tier: ~100 searches/month  |  Sign up at: https://serpapi.com
#
SERPAPI_API_KEY=your_serpapi_key_here

# Option B: Amadeus  (requires raw IATA codes, not city names)
#   Sign up at: https://developers.amadeus.com
#
# AMADEUS_CLIENT_ID=your_amadeus_client_id
# AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# ── Web server ──────────────────────────────────────────────────────────
PORT=5000
# FLASK_DEBUG=0
